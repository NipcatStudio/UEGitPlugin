+package lfshttp
+
+import (
+	"net/http"
+	"testing"
+
+	"github.com/stretchr/testify/assert"
+	"github.com/stretchr/testify/require"
+)
+
+// 显式空代理必须覆盖环境变量；URL 例外不能影响其它仓库或主机。
+// An explicitly empty proxy overrides the environment without affecting other URL scopes.
+func TestExplicitEmptyGitProxy(t *testing.T) {
+	for _, scheme := range []string{"http", "https"} {
+		t.Run(scheme+" global", func(t *testing.T) {
+			c, err := NewClient(NewContext(nil, map[string]string{
+				"HTTP_PROXY":  "http://environment-proxy:8080",
+				"HTTPS_PROXY": "http://environment-proxy:8080",
+			}, map[string]string{"http.proxy": ""}))
+			require.NoError(t, err)
+			req, err := http.NewRequest("GET", scheme+"://example.com/repo/info/lfs/locks", nil)
+			require.NoError(t, err)
+			proxy, err := proxyFromClient(c)(req)
+			require.NoError(t, err)
+			assert.Nil(t, proxy)
+		})
+	}
+
+	for _, fallback := range []string{"environment", "git"} {
+		t.Run("URL scope with "+fallback+" fallback", func(t *testing.T) {
+			gitConfig := map[string]string{"http.https://example.com/one.git/info/lfs.proxy": ""}
+			if fallback == "git" {
+				gitConfig["http.proxy"] = "http://git-proxy:8080"
+			}
+			c, err := NewClient(NewContext(nil, map[string]string{
+				"HTTP_PROXY":  "http://environment-proxy:8080",
+				"HTTPS_PROXY": "http://environment-proxy:8080",
+			}, gitConfig))
+			require.NoError(t, err)
+			for _, target := range []struct {
+				url    string
+				direct bool
+			}{
+				{"https://example.com/one.git/info/lfs", true},
+				{"https://example.com/one.git/info/lfs/locks/verify", true},
+				{"https://example.com/two.git/info/lfs/locks", false},
+				{"https://other.example.com/one.git/info/lfs/locks", false},
+			} {
+				req, err := http.NewRequest("POST", target.url, nil)
+				require.NoError(t, err)
+				proxy, err := proxyFromClient(c)(req)
+				require.NoError(t, err)
+				if target.direct {
+					assert.Nil(t, proxy, target.url)
+				} else {
+					require.NotNil(t, proxy, target.url)
+					assert.Equal(t, fallback+"-proxy:8080", proxy.Host)
+				}
+			}
+		})
+	}
+}
