diff --git a/tools/kv/filelock.go b/tools/kv/filelock.go
new file mode 100644
--- /dev/null
+++ b/tools/kv/filelock.go
@@ -0,0 +1,48 @@
+package kv
+
+import (
+	"fmt"
+	"os"
+	"time"
+)
+
+// 缓存竞争最多等待五秒；失败必须显式返回，不能当作空缓存。
+// Bound cache contention to five seconds; failure is never an empty cache.
+const cacheIOTimeout = 5 * time.Second
+
+// 旁路锁文件拥有跨进程互斥；不删除它，避免等待者锁住已被替换的 inode。
+// Keep a stable sidecar inode for interprocess exclusion; never unlink the lock file.
+func lockStore(filename string, deadline time.Time) (*os.File, error) {
+	file, err := os.OpenFile(filename+".lock", os.O_RDWR|os.O_CREATE, 0600)
+	if err != nil {
+		return nil, err
+	}
+	for {
+		err = tryLockStore(file)
+		if err == nil {
+			return file, nil
+		}
+		if err := retryCacheIO(filename, deadline, err, isCacheContention(err)); err != nil {
+			file.Close()
+			return nil, err
+		}
+	}
+}
+
+// 平台调用端决定哪些错误允许短暂重试；共享截止时间保证不会无限等待。
+// Platform callers classify transient failures; the shared deadline bounds every retry.
+func retryCacheIO(filename string, deadline time.Time, err error, retry bool) error {
+	if !retry {
+		return err
+	}
+	remaining := time.Until(deadline)
+	if remaining <= 0 {
+		return fmt.Errorf("timed out waiting for lock cache %s: %w", filename, err)
+	}
+	delay := 10 * time.Millisecond
+	if remaining < delay {
+		delay = remaining
+	}
+	time.Sleep(delay)
+	return nil
+}
diff --git a/tools/kv/filelock_windows.go b/tools/kv/filelock_windows.go
new file mode 100644
--- /dev/null
+++ b/tools/kv/filelock_windows.go
@@ -0,0 +1,60 @@
+//go:build windows
+// +build windows
+
+package kv
+
+import (
+	"errors"
+	"os"
+	"time"
+
+	"golang.org/x/sys/windows"
+)
+
+// 关闭句柄即释放内核锁，进程退出不会留下需要人工删除的死锁。
+// The kernel releases this lock on handle close or process exit.
+func tryLockStore(file *os.File) error {
+	return windows.LockFileEx(windows.Handle(file.Fd()),
+		windows.LOCKFILE_EXCLUSIVE_LOCK|windows.LOCKFILE_FAIL_IMMEDIATELY,
+		0, 1, 0, &windows.Overlapped{})
+}
+
+func isCacheContention(err error) bool {
+	return errors.Is(err, windows.ERROR_LOCK_VIOLATION) ||
+		errors.Is(err, windows.ERROR_SHARING_VIOLATION)
+}
+
+// 读取期间拒绝旧 LFS 写入者；发布前关闭句柄，修复版写入者仍由旁路锁排他。
+// Block legacy writes during the read; close before publication while the sidecar excludes patched writers.
+func openStoreSnapshot(filename string, deadline time.Time) (*os.File, error) {
+	path, err := windows.UTF16PtrFromString(filename)
+	if err != nil {
+		return nil, err
+	}
+	for {
+		handle, err := windows.CreateFile(path, windows.GENERIC_READ,
+			windows.FILE_SHARE_READ, nil,
+			windows.OPEN_EXISTING, windows.FILE_ATTRIBUTE_NORMAL, 0)
+		if err == nil {
+			return os.NewFile(uintptr(handle), filename), nil
+		}
+		if err := retryCacheIO(filename, deadline, err, isCacheContention(err)); err != nil {
+			return nil, &os.PathError{Op: "open", Path: filename, Err: err}
+		}
+	}
+}
+
+func replaceStoreSnapshot(source, destination string, deadline time.Time) error {
+	for {
+		if err := os.Rename(source, destination); err != nil {
+			// Windows 覆盖被读取的目标也可能返回 ACCESS_DENIED；只在重命名处有界重试。
+			// Replacing an open destination can also return ACCESS_DENIED; retry it only for rename.
+			retry := isCacheContention(err) || errors.Is(err, windows.ERROR_ACCESS_DENIED)
+			if err := retryCacheIO(destination, deadline, err, retry); err != nil {
+				return err
+			}
+		} else {
+			return nil
+		}
+	}
+}
diff --git a/tools/kv/filelock_unix.go b/tools/kv/filelock_unix.go
new file mode 100644
--- /dev/null
+++ b/tools/kv/filelock_unix.go
@@ -0,0 +1,30 @@
+//go:build !windows
+// +build !windows
+
+package kv
+
+import (
+	"errors"
+	"os"
+	"time"
+
+	"golang.org/x/sys/unix"
+)
+
+// 所有修复版读写者共享同一个旁路 inode，关闭句柄自动释放锁。
+// Patched readers and writers share one sidecar inode; close releases its lock.
+func tryLockStore(file *os.File) error {
+	return unix.Flock(int(file.Fd()), unix.LOCK_EX|unix.LOCK_NB)
+}
+
+func isCacheContention(err error) bool {
+	return errors.Is(err, unix.EWOULDBLOCK) || errors.Is(err, unix.EINTR)
+}
+
+func openStoreSnapshot(filename string, deadline time.Time) (*os.File, error) {
+	return os.Open(filename)
+}
+
+func replaceStoreSnapshot(source, destination string, deadline time.Time) error {
+	return os.Rename(source, destination)
+}
diff --git a/tools/kv/snapshot.go b/tools/kv/snapshot.go
new file mode 100644
--- /dev/null
+++ b/tools/kv/snapshot.go
@@ -0,0 +1,44 @@
+package kv
+
+import (
+	"io"
+	"os"
+	"path/filepath"
+	"time"
+)
+
+// WriteSnapshot 原子发布完整缓存；需要合并数据的调用者必须另持跨进程锁。
+// WriteSnapshot atomically publishes a complete cache; read/merge callers must also hold a process lock.
+func WriteSnapshot(filename string, write func(io.Writer) error) error {
+	return writeSnapshot(filename, time.Now().Add(cacheIOTimeout), write)
+}
+
+func writeSnapshot(filename string, deadline time.Time, write func(io.Writer) error) error {
+	mode := os.FileMode(0600)
+	if info, err := os.Stat(filename); err == nil {
+		mode = info.Mode().Perm()
+	} else if !os.IsNotExist(err) {
+		return err
+	}
+	tmp, err := os.CreateTemp(filepath.Dir(filename), "."+filepath.Base(filename)+".tmp-")
+	if err != nil {
+		return err
+	}
+	defer os.Remove(tmp.Name())
+	defer tmp.Close()
+	if err := tmp.Chmod(mode); err != nil {
+		return err
+	}
+	// 任一步失败均不覆盖旧快照；临时文件不会成为下一次查询的数据源。
+	// Any failure retains the old snapshot; temporary files are never read as cache state.
+	if err := write(tmp); err != nil {
+		return err
+	}
+	if err := tmp.Sync(); err != nil {
+		return err
+	}
+	if err := tmp.Close(); err != nil {
+		return err
+	}
+	return replaceStoreSnapshot(tmp.Name(), filename, deadline)
+}
