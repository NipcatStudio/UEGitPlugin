@@ -0,0 +1,163 @@
+package kv
+
+import (
+	"bufio"
+	"bytes"
+	"fmt"
+	"os"
+	"os/exec"
+	"path/filepath"
+	"strings"
+	"testing"
+	"time"
+
+	"github.com/stretchr/testify/require"
+)
+
+// 子进程只操作父测试传入的临时缓存；就绪握手确保多个进程从同一旧版本开始保存。
+// Child helpers touch only a temporary cache; readiness aligns independent stale snapshots.
+func TestStoreProcessHelper(t *testing.T) {
+	mode := os.Getenv("LFS_KV_TEST_HELPER")
+	if mode == "" {
+		return
+	}
+	filename := os.Getenv("LFS_KV_TEST_FILE")
+	if mode == "exit-with-lock" {
+		_, err := lockStore(filename, time.Now().Add(time.Second))
+		if err != nil {
+			fmt.Fprintln(os.Stderr, err)
+			os.Exit(1)
+		}
+		os.Exit(0)
+	}
+	store, err := NewStore(filename)
+	if err != nil {
+		fmt.Fprintln(os.Stderr, err)
+		os.Exit(1)
+	}
+	fmt.Println("ready")
+	_, err = bufio.NewReader(os.Stdin).ReadString('\n')
+	if err != nil {
+		os.Exit(1)
+	}
+	store.Set(os.Getenv("LFS_KV_TEST_KEY"), strings.Repeat("value", 4096))
+	if err := store.Save(); err != nil {
+		fmt.Fprintln(os.Stderr, err)
+		os.Exit(1)
+	}
+}
+
+func TestStoreConcurrentProcessesMerge(t *testing.T) {
+	filename := filepath.Join(t.TempDir(), "lockcache.db")
+	store, err := NewStore(filename)
+	require.NoError(t, err)
+	store.Set("original", "preserved")
+	require.NoError(t, store.Save())
+	// 父测试拥有子进程、放行管道和错误输出，失败路径也必须回收它们。
+	// The parent owns each process, release pipe and error stream, including failure cleanup.
+	type child struct {
+		command *exec.Cmd
+		release func()
+		stderr  *bytes.Buffer
+	}
+	var children []child
+	for i := 0; i < 6; i++ {
+		command := exec.Command(os.Args[0], "-test.run=^TestStoreProcessHelper$")
+		command.Env = append(os.Environ(), "LFS_KV_TEST_HELPER=write", "LFS_KV_TEST_FILE="+filename,
+			fmt.Sprintf("LFS_KV_TEST_KEY=worker-%d", i))
+		stdout, err := command.StdoutPipe()
+		require.NoError(t, err)
+		stdin, err := command.StdinPipe()
+		require.NoError(t, err)
+		stderr := &bytes.Buffer{}
+		command.Stderr = stderr
+		require.NoError(t, command.Start())
+		// 测试失败也关闭 stdin 并回收子进程，不留下后台写入者。
+		// Even assertion failures close stdin and reap the child instead of leaking a writer.
+		t.Cleanup(func() { stdin.Close(); command.Wait() })
+		line, err := bufio.NewReader(stdout).ReadString('\n')
+		require.NoError(t, err, stderr.String())
+		require.Equal(t, "ready\n", line)
+		children = append(children, child{command, func() { fmt.Fprintln(stdin, "save"); stdin.Close() }, stderr})
+	}
+	for _, child := range children {
+		child.release()
+	}
+	for _, child := range children {
+		require.NoError(t, child.command.Wait(), child.stderr.String())
+	}
+	final, err := NewStore(filename)
+	require.NoError(t, err)
+	require.Equal(t, "preserved", final.Get("original"))
+	for i := range children {
+		require.Equal(t, strings.Repeat("value", 4096), final.Get(fmt.Sprintf("worker-%d", i)))
+	}
+}
+
+func TestStoreAtomicEncodeFailure(t *testing.T) {
+	filename := filepath.Join(t.TempDir(), "lockcache.db")
+	store, err := NewStore(filename)
+	require.NoError(t, err)
+	store.Set("original", "preserved")
+	require.NoError(t, store.Save())
+	original, err := os.ReadFile(filename)
+	require.NoError(t, err)
+	store.Set("unencodable", make(chan int))
+	require.Error(t, store.Save())
+	after, err := os.ReadFile(filename)
+	require.NoError(t, err)
+	require.Equal(t, original, after)
+	loaded, err := NewStore(filename)
+	require.NoError(t, err)
+	require.Equal(t, "preserved", loaded.Get("original"))
+	store.Remove("unencodable")
+	store.Set("retry", "saved")
+	require.NoError(t, store.Save())
+	loaded, err = NewStore(filename)
+	require.NoError(t, err)
+	require.Equal(t, "saved", loaded.Get("retry"))
+	residue, err := filepath.Glob(filepath.Join(filepath.Dir(filename), ".lockcache.db.tmp-*"))
+	require.NoError(t, err)
+	require.Empty(t, residue)
+}
+
+func TestStoreCorruptMergePreservesEvidence(t *testing.T) {
+	filename := filepath.Join(t.TempDir(), "lockcache.db")
+	store, err := NewStore(filename)
+	require.NoError(t, err)
+	store.Set("original", "preserved")
+	require.NoError(t, store.Save())
+	corrupt := []byte("invalid gob snapshot")
+	require.NoError(t, os.WriteFile(filename, corrupt, 0600))
+	store.Set("pending", "not published")
+	require.Error(t, store.Save())
+	after, err := os.ReadFile(filename)
+	require.NoError(t, err)
+	require.Equal(t, corrupt, after)
+	require.NotEmpty(t, store.log)
+}
+
+func TestStoreInterprocessLockReleasedOnExit(t *testing.T) {
+	filename := filepath.Join(t.TempDir(), "lockcache.db")
+	command := exec.Command(os.Args[0], "-test.run=^TestStoreProcessHelper$")
+	command.Env = append(os.Environ(), "LFS_KV_TEST_HELPER=exit-with-lock", "LFS_KV_TEST_FILE="+filename)
+	output, err := command.CombinedOutput()
+	require.NoError(t, err, string(output))
+	guard, err := lockStore(filename, time.Now().Add(time.Second))
+	require.NoError(t, err)
+	require.NoError(t, guard.Close())
+	_, err = os.Stat(filename + ".lock")
+	require.NoError(t, err)
+}
+
+func TestStoreLockWaitIsBounded(t *testing.T) {
+	filename := filepath.Join(t.TempDir(), "lockcache.db")
+	guard, err := lockStore(filename, time.Now().Add(time.Second))
+	require.NoError(t, err)
+	defer guard.Close()
+	start := time.Now()
+	_, err = lockStore(filename, start.Add(30*time.Millisecond))
+	require.Error(t, err)
+	require.Contains(t, err.Error(), "timed out waiting for lock cache")
+	require.True(t, time.Since(start) < 2*time.Second)
+}
