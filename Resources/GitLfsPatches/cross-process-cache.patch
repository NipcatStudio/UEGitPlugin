+//go:build windows
+// +build windows
+
+package kv
+
+import (
+	"io"
+	"os"
+	"path/filepath"
+	"testing"
+	"time"
+
+	"github.com/stretchr/testify/require"
+)
+
+// 旧客户端的读句柄阻止 Windows 替换时，先有界失败并保留旧快照，释放后可正常发布。
+// A legacy reader must cause bounded publication failure, not truncation; release permits a retry.
+func TestSnapshotLegacyReaderContention(t *testing.T) {
+	filename := filepath.Join(t.TempDir(), "verifiable")
+	require.NoError(t, os.WriteFile(filename, []byte("old snapshot"), 0600))
+	reader, err := os.Open(filename)
+	require.NoError(t, err)
+	defer reader.Close()
+	write := func(w io.Writer) error {
+		_, err := io.WriteString(w, "new snapshot")
+		return err
+	}
+	err = writeSnapshot(filename, time.Now().Add(40*time.Millisecond), write)
+	require.Error(t, err)
+	require.Contains(t, err.Error(), "timed out waiting for lock cache")
+	content, err := os.ReadFile(filename)
+	require.NoError(t, err)
+	require.Equal(t, "old snapshot", string(content))
+	require.NoError(t, reader.Close())
+	require.NoError(t, WriteSnapshot(filename, write))
+	content, err = os.ReadFile(filename)
+	require.NoError(t, err)
+	require.Equal(t, "new snapshot", string(content))
+}
