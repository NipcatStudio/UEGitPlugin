@@ -0,0 +1,82 @@
+package locking
+
+import (
+	"encoding/json"
+	"net/http"
+	"net/http/httptest"
+	"strings"
+	"sync"
+	"sync/atomic"
+	"testing"
+	"time"
+
+	"github.com/git-lfs/git-lfs/v3/config"
+	"github.com/git-lfs/git-lfs/v3/git"
+	"github.com/git-lfs/git-lfs/v3/lfsapi"
+	"github.com/git-lfs/git-lfs/v3/lfshttp"
+	"github.com/stretchr/testify/assert"
+	"github.com/stretchr/testify/require"
+)
+
+// 本地服务验证并发上限、精确 ID、原分支和非强制语义；不访问真实锁服务。
+// A local server checks bounded concurrency, exact IDs, frozen ref and non-force semantics.
+func TestUnlockMultipleIds(t *testing.T) {
+	var active, peak int32
+	var mu sync.Mutex
+	seen := map[string]int{}
+	srv := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		assert.Equal(t, "POST", r.Method)
+		assert.True(t, strings.HasPrefix(r.URL.Path, "/api/locks/"))
+		assert.True(t, strings.HasSuffix(r.URL.Path, "/unlock"))
+		id := strings.TrimSuffix(strings.TrimPrefix(r.URL.Path, "/api/locks/"), "/unlock")
+		var body struct {
+			Force bool `json:"force"`
+			Ref   struct {
+				Name string `json:"name"`
+			} `json:"ref"`
+		}
+		assert.NoError(t, json.NewDecoder(r.Body).Decode(&body))
+		assert.False(t, body.Force)
+		assert.Equal(t, "refs/heads/test", body.Ref.Name)
+		n := atomic.AddInt32(&active, 1)
+		defer atomic.AddInt32(&active, -1)
+		mu.Lock()
+		if n > peak {
+			peak = n
+		}
+		seen[id]++
+		mu.Unlock()
+		time.Sleep(40 * time.Millisecond)
+		w.Header().Set("Content-Type", "application/vnd.git-lfs+json")
+		if id == "blocked" {
+			w.WriteHeader(http.StatusConflict)
+			json.NewEncoder(w).Encode(map[string]string{"message": "still locked"})
+		} else {
+			json.NewEncoder(w).Encode(map[string]interface{}{"lock": Lock{Id: id, Path: "Content/" + id + ".uasset"}})
+		}
+	}))
+	defer srv.Close()
+	api, err := lfsapi.NewClient(lfshttp.NewContext(nil, nil, map[string]string{"lfs.url": srv.URL + "/api"}))
+	require.NoError(t, err)
+	client, err := NewClient("", api, config.New())
+	require.NoError(t, err)
+	defer client.Close()
+	client.RemoteRef = &git.Ref{Name: "test", Type: git.RefTypeLocalBranch}
+	client.ConcurrentRequests = 2
+	ids := []string{"id-0", "id-1", "id,2", "blocked", "id-4", "id-5"}
+	results := client.UnlockMultipleIds(ids, false, "")
+	mu.Lock()
+	defer mu.Unlock()
+	require.Equal(t, int32(2), peak)
+	for _, id := range ids {
+		assert.Equal(t, 1, seen[id])
+		result, ok := results.Load(id)
+		require.True(t, ok)
+		if id == "blocked" {
+			_, isError := result.(error)
+			assert.True(t, isError)
+		} else {
+			assert.Equal(t, true, result)
+		}
+	}
+}
