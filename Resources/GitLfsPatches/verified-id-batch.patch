index 50bb6fa..0c3778f 100644
--- a/locking/locks.go
+++ b/locking/locks.go
@@ -298,6 +298,34 @@ func (c *Client) UnlockMultipleFiles(paths []string, force bool, repo string) (*
 	return &lockMap, nil
 }
 
+// 在同一个客户端和缓存内并发释放明确给定的 ID，不按路径重新寻找另一个锁。
+// Release supplied IDs concurrently in one client/cache, without resolving different locks by path.
+func (c *Client) UnlockMultipleIds(ids []string, force bool, repo string) *sync.Map {
+	c.client.CacheUploadClient(c.Remote)
+	results := &sync.Map{}
+	concurrency := c.ConcurrentRequests
+	if concurrency < 1 {
+		concurrency = 1
+	}
+	limiter := make(chan struct{}, concurrency)
+	var done sync.WaitGroup
+	for _, id := range ids {
+		limiter <- struct{}{}
+		done.Add(1)
+		go func(id string) {
+			defer done.Done()
+			defer func() { <-limiter }()
+			if err := c.UnlockFileById(id, force, repo); err != nil {
+				results.Store(id, err)
+			} else {
+				results.Store(id, true)
+			}
+		}(id)
+	}
+	done.Wait()
+	return results
+}
+
 // UnlockFileById attempts to unlock a lock with a given id on the current remote
 // Force causes the file to be unlocked from other users as well
